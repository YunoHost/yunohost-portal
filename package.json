{
  "name": "yunohost-portal",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "nuxt build",
    "dev": "nuxt dev",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "lint:js": "eslint --ext \".ts,.vue,.cjs,.js\" --ignore-path .gitignore .",
    "lint:prettier": "prettier --check .",
    "lint": "$npm_execpath lint:js && $npm_execpath lint:prettier",
    "lintfix": "prettier --write --list-different . && $npm_execpath lint:js --fix",
    "upgrade-deps": "$npm_execpath upgrade-interactive --latest"
  },
  "dependencies": {
    "@nuxt/devtools": "^4.2.0",
    "@nuxt/eslint": "^1.17.0",
    "@nuxt/fonts": "^1.2.0",
    "@nuxt/icon": "^2.6.3",
    "@nuxt/kit": "^4.6.4",
    "@nuxtjs/color-mode": "^4.1.0",
    "@nuxtjs/i18n": "^10.6.0",
    "@tailwindcss/vite": "^4.3.5",
    "@vee-validate/nuxt": "^4.15.1",
    "@vee-validate/yup": "^4.13.2",
    "daisyui": "^5.8.0",
    "nuxt": "^4.0.0",
    "nuxt-icons": "^4.0.0",
    "tailwindcss": "^4.3.5",
    "vite": "^8.3.8",
    "vue": "^3.5.46",
    "vue-router": "^5.5.1",
    "yup": "^1.7.1"
  },
  "devDependencies": {
    "eslint": "^10.15.0",
    "prettier": "^3.3.3",
    "typescript": "^6.0.0"
  }
}
